---
import type { ProductImage } from '@/domain/product';
import { imageSource } from '@/domain/product';
const { images } = Astro.props as { images: ProductImage[] };
const primary = images.find((image) => imageSource(image));
---
<div class="gallery"><div class="gallery-main">{primary ? <><img src={imageSource(primary)} alt={primary.alt} width={primary.width} height={primary.height} fetchpriority="high" /><span class="zoom-hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg></span></> : <span class="placeholder"><span>Imagem indisponível</span></span>}</div>{images.filter((item) => imageSource(item)).length > 1 && <div class="gallery-thumbs" aria-label="Outras vistas do equipamento">{images.filter((item) => imageSource(item)).map((item, index) => <button type="button" aria-label={`Ver imagem ${index + 1}`} data-gallery-src={imageSource(item)}><img src={imageSource(item)} alt="" width="90" height="70" loading="lazy" /></button>)}</div>}</div>
<style>.gallery-main{position:relative;overflow:hidden;display:grid;place-items:center;min-height:420px;padding:2rem;background:var(--surface-2);border:1px solid var(--border)}.gallery-main img{width:100%;height:420px;object-fit:contain}.gallery-main.zoomed img{transform:scale(2)}.zoom-hint{position:absolute;right:.75rem;bottom:.75rem;display:inline-flex;align-items:center;justify-content:center;width:2.25rem;height:2.25rem;border-radius:50%;background:var(--surface);border:1px solid var(--border);color:var(--text);opacity:.9;pointer-events:none;transition:opacity .15s ease}.gallery-main.zoomed .zoom-hint{opacity:0}.gallery-thumbs{display:flex;gap:.5rem;margin-top:.5rem}.gallery-thumbs button{padding:.2rem;background:var(--surface);border:1px solid var(--border);cursor:pointer}.gallery-thumbs img{width:80px;height:60px;object-fit:contain}@media(hover:hover) and (pointer:fine){.gallery-main img{cursor:zoom-in;transition:transform .2s ease}}@media(max-width:620px){.gallery-main{min-height:280px}.gallery-main img{height:280px}}</style>
<style>@media not all and (hover:hover) and (pointer:fine){.zoom-hint{display:none}}</style>
<script is:inline>document.querySelectorAll('[data-gallery-src]').forEach((button) => button.addEventListener('click', () => { const main = document.querySelector('.gallery-main img'); const source = button.getAttribute('data-gallery-src'); if (main && source) { main.src = source; document.querySelectorAll('[data-gallery-src]').forEach((item) => item.removeAttribute('aria-current')); button.setAttribute('aria-current', 'true'); } }));</script>
<script is:inline>if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) { document.querySelectorAll('.gallery-main img').forEach((image) => { const stage = image.closest('.gallery-main'); if (!stage) return; image.addEventListener('mouseenter', () => stage.classList.add('zoomed')); image.addEventListener('mousemove', (event) => { const rect = image.getBoundingClientRect(); const x = ((event.clientX - rect.left) / rect.width) * 100; const y = ((event.clientY - rect.top) / rect.height) * 100; image.style.transformOrigin = `${x}% ${y}%`; }); image.addEventListener('mouseleave', () => { stage.classList.remove('zoomed'); image.style.transformOrigin = ''; }); }); }</script>
