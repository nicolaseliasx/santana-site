---
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { generalWhatsApp } from '@/lib/whatsapp';
---
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand" href="/"><img src="/brand/logo.jpg" alt="Santana Fitness" width="130" height="43" /></a><p class="muted">Equipamentos para quem leva o treino a sério.</p></div><div><h2 class="display">Navegue</h2><a href="/produtos/">Produtos</a><a href="/categorias/">Categorias</a><a href="/sobre/">Sobre</a></div><div><h2 class="display">Fale com a equipe</h2><a href="mailto:santanafitness@santanafitness.com.br">santanafitness@santanafitness.com.br</a><a class="footer-whatsapp" href={generalWhatsApp()}><WhatsAppIcon /> (48) 99926-3333</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Santana Fitness</span><span>Catálogo de equipamentos</span></div></footer>
<style>.site-footer { padding-block: 3rem 1.25rem; background: var(--surface-2); border-top: 1px solid var(--border); }.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1.5fr; gap: 2rem; }.footer-grid .brand img { display:block; width:130px; height:43px; object-fit:contain; background:transparent; mix-blend-mode:multiply; }.footer-grid h2 { font-size: 1.1rem; letter-spacing: .04em; margin: 0 0 .8rem; }.footer-grid a:not(.brand) { display: block; margin: .4rem 0; text-decoration: none; overflow-wrap:anywhere; }.footer-bottom { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .875rem; }@media(max-width:620px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{flex-direction:column; margin-top:2rem}}</style>
