---
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { catalogGroups } from '@/data/catalog';
import { generalWhatsApp } from '@/lib/whatsapp';
---
<header class="site-header">
  <div class="container header-inner"><a class="brand" href="/" aria-label="Santana Fitness — início"><img src="/brand/logo.jpg" alt="Santana Fitness" width="130" height="43" /></a>
    <nav class="desktop-nav" aria-label="Navegação principal"><a href="/produtos/">Produtos</a><div class="category-disclosure"><a href="/categorias/" aria-expanded="false" aria-controls="category-menu" data-category-link>Categorias</a><div id="category-menu" class="category-menu" hidden>{catalogGroups.map((group) => <a href={`/categorias/${group.slug}/`}>{group.name}</a>)}</div></div><a href="/sobre/">Sobre</a><a href="/contato/">Contato</a></nav>
    <div class="header-actions"><a class="header-whatsapp" href={generalWhatsApp()}><WhatsAppIcon /><span>WhatsApp</span></a><button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span></span><span></span><span></span></button></div>
  </div>
  <nav id="mobile-menu" class="mobile-menu container" aria-label="Navegação móvel" hidden><a href="/produtos/">Produtos</a><a href="/categorias/">Categorias</a><details><summary>Categorias por tipo</summary><div class="mobile-categories">{catalogGroups.map((group) => <a href={`/categorias/${group.slug}/`}>{group.name}</a>)}</div></details><a href="/sobre/">Sobre</a><a href="/contato/">Contato</a></nav>
</header>
<script is:inline>
  (() => { const menu = document.querySelector('[data-menu-toggle]'); const nav = document.querySelector('#mobile-menu'); const disclosure = document.querySelector('.category-disclosure'); const link = document.querySelector('[data-category-link]'); const menuPanel = document.querySelector('#category-menu'); if (menu && nav) menu.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') === 'true'; menu.setAttribute('aria-expanded', String(!open)); menu.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu'); nav.hidden = open; }); if (link && menuPanel && disclosure) { const open = () => { menuPanel.hidden = false; link.setAttribute('aria-expanded', 'true'); }; const close = () => { menuPanel.hidden = true; link.setAttribute('aria-expanded', 'false'); }; disclosure.addEventListener('mouseenter', open); disclosure.addEventListener('mouseleave', close); disclosure.addEventListener('focusin', open); disclosure.addEventListener('focusout', (event) => { if (!disclosure.contains(event.relatedTarget)) close(); }); link.addEventListener('click', () => { if (window.matchMedia('(pointer: coarse)').matches) { if (menuPanel.hidden) open(); else close(); } }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { close(); link.focus(); } }); document.addEventListener('click', (event) => { if (!disclosure.contains(event.target)) close(); }); } })();
</script>
<style>
  .site-header{position:sticky;z-index:10;top:0;background:var(--bg);border-bottom:1px solid var(--border)}.header-inner{min-height:72px;display:flex;align-items:center;gap:2rem}.brand{display:inline-flex;align-items:center;text-decoration:none;line-height:.82}.brand img{display:block;width:130px;height:43px;object-fit:contain;mix-blend-mode:multiply}.desktop-nav{display:flex;gap:1.5rem;margin-left:auto;align-items:center;font-weight:600}.desktop-nav a{text-decoration:none}.desktop-nav a:hover,.desktop-nav a:focus-visible{color:var(--red)}.category-disclosure{position:relative}.category-menu{position:absolute;z-index:12;top:calc(100% + 1.2rem);left:50%;width:430px;display:grid;grid-template-columns:1fr 1fr;gap:.2rem;padding:1rem;background:var(--surface);border:1px solid var(--border);box-shadow:var(--shadow);transform:translateX(-50%)}.category-menu::before{content:'';position:absolute;top:-1.2rem;left:0;right:0;height:1.2rem}.category-menu[hidden]{display:none}.category-menu a{padding:.65rem;color:var(--text);font-weight:600;overflow-wrap:anywhere}.header-actions{display:flex;align-items:center;gap:.55rem}.header-whatsapp{display:inline-flex;align-items:center;gap:.4rem;padding:.55rem .8rem;background:#25D366;color:#fff;font-weight:700;text-decoration:none;border-radius:var(--radius-sm)}.whatsapp-icon{width:1.15rem;height:1.15rem}.menu-toggle{display:none;min-width:44px;min-height:44px;cursor:pointer;background:transparent;border:1px solid var(--border);border-radius:var(--radius-sm)}.menu-toggle span{display:block;width:22px;height:2px;margin:4px auto;background:var(--text)}.mobile-menu{display:none;padding-bottom:1rem}.mobile-menu>a,.mobile-menu summary{padding:.65rem 0;font-weight:600;text-decoration:none;cursor:pointer}.mobile-menu details{border-block:1px solid var(--border)}.mobile-categories{display:grid;grid-template-columns:1fr 1fr;padding:0 0 .7rem;gap:.2rem .8rem}.mobile-categories a{padding:.55rem 0;font-size:.95rem;text-decoration:none;overflow-wrap:anywhere}@media(max-width:720px){.desktop-nav{display:none}.header-inner{gap:.6rem}.header-actions{margin-left:auto}.header-whatsapp{font-size:.85rem}.menu-toggle{display:block}.mobile-menu[hidden]{display:none}.mobile-menu:not([hidden]){display:grid;gap:.15rem}}
</style>
