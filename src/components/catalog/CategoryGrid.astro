---
import type { CatalogGroup } from '@/domain/catalog-group';
import CategoryCard from './CategoryCard.astro';
const { groups } = Astro.props as { groups: CatalogGroup[] };
---
<div class="category-grid" role="list">
  {groups.map((group, index) => <CategoryCard group={group} index={index} />)}
</div>
<style>
  .category-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-top:1px solid var(--border); border-left:1px solid var(--border); }
  @media (max-width:1024px) { .category-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:479px) { .category-grid { grid-template-columns:1fr; } }
</style>
