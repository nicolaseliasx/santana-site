---
import BaseLayout from '@/layouts/BaseLayout.astro'; import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro'; import { generalWhatsApp } from '@/lib/whatsapp';
---
<BaseLayout title="Contato" description="Fale com a equipe Santana Fitness."><section class="section contact"><div class="container"><span class="eyebrow">Contato</span><h1 class="display">Vamos conversar<br /><em>sobre seu espaço</em></h1><div class="contact-grid"><div><p class="lead">Nossa equipe ajuda você a encontrar os equipamentos certos para o seu projeto.</p></div><div class="contact-links"><a href="mailto:santanafitness@santanafitness.com.br"><span class="eyebrow">E-mail</span><strong>santanafitness@santanafitness.com.br</strong></a><a class="contact-whatsapp" href={generalWhatsApp()}><span class="eyebrow">WhatsApp</span><strong><WhatsAppIcon /> (48) 99926-3333</strong></a></div></div></div></section></BaseLayout>
<style>.contact h1{font-size:clamp(3.5rem,9vw,8rem);line-height:.82;margin:1rem 0 4rem}.contact h1 em{font-style:normal;color:var(--red)}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;border-top:1px solid var(--border);padding-top:2rem}.lead{font-size:1.3rem;color:var(--muted);max-width:34ch}.contact-links{display:grid;gap:1rem}.contact-links a{display:grid;gap:.2rem;padding:1.25rem 0;border-bottom:1px solid var(--border);text-decoration:none}.contact-links strong{font-size:1.2rem}@media(max-width:720px){.contact-grid{grid-template-columns:1fr;gap:2rem}}</style>
