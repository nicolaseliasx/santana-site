---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/catalog/ProductCard.astro';
import CategoryGrid from '@/components/catalog/CategoryGrid.astro';
import WhatsAppButton from '@/components/ui/WhatsAppButton.astro';
import { catalogGroups, products } from '@/data/catalog';
import { heroProducts, dailySelection } from '@/lib/home-selection';
import { generalWhatsApp } from '@/lib/whatsapp';
const hero = heroProducts(products, 8);
const selection = dailySelection(products, new Date(), 12, hero);
---
<BaseLayout title="Santana Fitness | Equipamentos para performance" description="Catálogo de equipamentos Santana Fitness para academias, condomínios e treinos de alta performance.">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><h1 class="display">Treino forte<br /><em>Estrutura à altura</em></h1><p>Equipamentos para academias, condomínios e espaços de treinamento que colocam a performance em primeiro lugar</p><div class="hero-actions"><a class="button button-primary" href="/produtos/">Explorar produtos</a><WhatsAppButton href={generalWhatsApp()}>Chamar no WhatsApp</WhatsAppButton></div></div><div class="hero-carousel" data-hero-carousel aria-label="Produtos em destaque"><div class="hero-slides">{hero.map((product, index) => <a class={`hero-slide ${index === 0 ? 'is-active' : ''}`} href={`/produtos/${product.slug}/`} data-hero-slide={index} aria-hidden={index === 0 ? 'false' : 'true'}><img src={product.images[0].cutout?.src || product.images[0].localOriginal} alt={`Equipamento ${product.name} — vista principal`} width={product.images[0].width} height={product.images[0].height} fetchpriority={index === 0 ? 'high' : undefined} /><span>{product.name}</span></a>)}</div><div class="hero-controls"><button type="button" data-hero-prev aria-label="Produto anterior">←</button><div class="hero-indicators">{hero.map((_, index) => <button type="button" data-hero-indicator={index} aria-label={`Ver produto ${index + 1}`} aria-current={index === 0 ? 'true' : undefined}></button>)}</div><button type="button" data-hero-next aria-label="Próximo produto">→</button></div></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><h2 class="display">Encontre por categoria</h2><a href="/categorias/">Ver todas</a></div><CategoryGrid groups={catalogGroups.slice(0, 8)} /></div></section>
  <section class="section featured-section"><div class="container"><div class="section-heading"><h2 class="display">Seleção Santana</h2><a href="/produtos/">Ver catálogo completo</a></div><div class="grid product-grid">{selection.map((product) => <ProductCard product={product} />)}</div></div></section>
  <section class="section pillars"><div class="container pillar-layout"><div><h2 class="display">Qualidade que acompanha cada treino</h2></div><div class="pillar-list">{['Design', 'Robustez', 'Qualidade', 'Durabilidade'].map((pillar) => <div><strong>{pillar}</strong></div>)}</div></div></section>
  <section class="cta-section"><div class="container cta-inner"><div><h2 class="display">Vamos equipar seu espaço</h2><p>Converse conosco sobre os equipamentos ideais para o seu espaço</p></div><WhatsAppButton href={generalWhatsApp()}>Chamar no WhatsApp</WhatsAppButton></div></section>
</BaseLayout>
<style>
.hero{padding:clamp(3rem,8vw,7rem) 0;border-bottom:1px solid var(--border);overflow:hidden}.hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:4rem}.hero-grid>*{min-width:0}.hero-copy h1{margin:0 0 1.25rem;font-size:clamp(3.8rem,7.5vw,7.2rem);line-height:.82}.hero-copy h1 em{font-style:normal;color:var(--red)}.hero-copy p{max-width:42ch;color:var(--muted);font-size:1.2rem}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:2rem}.hero-carousel{position:relative;min-height:440px;padding:1.5rem;background:var(--surface-2);border:1px solid var(--border)}.hero-slides{position:relative;height:390px}.hero-slide{position:absolute;inset:0;display:grid;place-items:center;opacity:0;visibility:hidden;transition:opacity .3s ease}.hero-slide.is-active{opacity:1;visibility:visible}.hero-slide img{display:block;width:100%;height:360px;object-fit:contain}.hero-slide span{position:absolute;bottom:0;left:0;color:var(--muted);font-weight:700;overflow-wrap:anywhere}.hero-controls{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin-top:.75rem}.hero-controls button{min-width:44px;min-height:44px;border:1px solid var(--border);background:var(--surface);cursor:pointer}.hero-indicators{display:flex;gap:.35rem;justify-content:center}.hero-indicators button{min-width:28px;min-height:28px;border:0;background:transparent;position:relative}.hero-indicators button::after{content:'';position:absolute;inset:10px;border-radius:50%;background:var(--border)}.hero-indicators button[aria-current=true]::after{background:var(--red)}.featured-section{background:var(--surface-2)}.pillars{background:#17191b;color:#f5f3ec}.pillar-layout{display:grid;grid-template-columns:1fr 1fr;gap:4rem}.pillar-layout>*{min-width:0}.pillars h2{margin:0;font-size:clamp(3rem,6vw,6rem);line-height:.84}.pillar-list{border-top:1px solid #454a4d;display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.pillar-list>div{display:flex;align-items:center;justify-content:center;min-width:0;min-height:100px;padding:1.2rem;border-bottom:1px solid #454a4d}.pillar-list strong{font:600 1.7rem/1.1 'Source Sans 3',Arial,sans-serif;color:var(--yellow)}.cta-section{padding:4rem 0;background:var(--yellow);color:#151515}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:2rem}.cta-inner h2{font-size:clamp(2.5rem,5vw,4.5rem);line-height:.85;margin:0}.cta-inner p{margin-bottom:0}.cta-inner .button{border-color:#151515}@media(max-width:720px){.hero-grid,.pillar-layout{grid-template-columns:1fr;gap:2.5rem}.hero-copy h1{font-size:clamp(3.25rem,16vw,3.8rem)}.hero-carousel{min-height:320px}.hero-slides{height:260px}.hero-slide img{height:235px}.hero-indicators{gap:0}.hero-indicators button{width:20px;min-width:20px;min-height:44px}.hero-indicators button::after{inset:auto;top:50%;left:50%;width:6px;height:6px;transform:translate(-50%,-50%)}.pillar-list>div{padding-inline:.5rem}.pillar-list strong{font-size:clamp(1.25rem,7vw,1.7rem)}.category-grid{grid-template-columns:1fr}.cta-inner{align-items:start;flex-direction:column}}@media(prefers-reduced-motion:reduce){.hero-slide{transition:none}}
</style>
<script is:inline>
(() => { const root = document.querySelector('[data-hero-carousel]'); if (!root) return; const slides = [...root.querySelectorAll('[data-hero-slide]')]; const indicators = [...root.querySelectorAll('[data-hero-indicator]')]; if (slides.length < 2) return; let current = 0; let timer; let paused = false; const show = (index) => { current = (index + slides.length) % slides.length; slides.forEach((slide, i) => { slide.classList.toggle('is-active', i === current); slide.setAttribute('aria-hidden', String(i !== current)); }); indicators.forEach((button, i) => button.setAttribute('aria-current', i === current ? 'true' : 'false')); }; const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; }; const start = () => { stop(); if (!paused && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden) timer = window.setInterval(() => show(current + 1), 6000); }; const pause = () => { paused = true; stop(); }; const resume = () => { paused = false; start(); }; root.querySelector('[data-hero-prev]').addEventListener('click', () => { show(current - 1); pause(); }); root.querySelector('[data-hero-next]').addEventListener('click', () => { show(current + 1); pause(); }); indicators.forEach((button, i) => button.addEventListener('click', () => { show(i); pause(); })); root.addEventListener('mouseenter', pause); root.addEventListener('mouseleave', resume); root.addEventListener('focusin', pause); root.addEventListener('focusout', (event) => { if (!root.contains(event.relatedTarget)) resume(); }); document.addEventListener('visibilitychange', () => document.hidden ? stop() : start()); let startX = 0; root.addEventListener('touchstart', (event) => { startX = event.changedTouches[0].clientX; pause(); }, { passive: true }); root.addEventListener('touchend', (event) => { const delta = event.changedTouches[0].clientX - startX; if (Math.abs(delta) > 40) show(current + (delta < 0 ? 1 : -1)); }, { passive: true }); root.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); pause(); } if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); pause(); } }); start(); })();
</script>
