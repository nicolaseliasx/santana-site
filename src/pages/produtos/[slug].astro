---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Gallery from '@/components/product/Gallery.astro'; import RelatedProducts from '@/components/product/RelatedProducts.astro'; import WhatsAppButton from '@/components/ui/WhatsAppButton.astro'; import { products, productBySlug, catalogGroupBySlug, relatedProducts } from '@/data/catalog'; import { productWhatsApp } from '@/lib/whatsapp';
export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug } })); }
const product = productBySlug(Astro.params.slug!); if (!product) throw new Error('Produto não encontrado'); const category = catalogGroupBySlug(product.catalogGroupSlug);
---
<BaseLayout title={product.name} description={product.summary || `Equipamento ${product.name}.`} canonical={`https://santanafitness.com.br/produtos/${product.slug}/`} image={product.images[0]?.localOriginal}>
  <section class="section product-detail"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Início</a><span>/</span><a href="/produtos/">Produtos</a>{category && <><span>/</span><a href={`/categorias/${category.slug}/`}>{category.name}</a></>}</nav><div class="detail-grid"><Gallery images={product.images} /><div class="product-copy">{category && <span class="eyebrow">{category.name}</span>}<h1 class="display">{product.name}</h1><p class="price product-price" aria-label={`Preço: ${product.priceFormatted}`}>{product.priceFormatted}</p>{product.code && <p class="ref">Ref. {product.code}</p>}{product.summary && <p class="lead">{product.summary}</p>}<WhatsAppButton class="product-whatsapp" href={productWhatsApp(product)}>Falar sobre este equipamento</WhatsAppButton>{Boolean(product.description || product.features.length || product.specifications.length) && <div class="copy-block"><h2 class="display">Informações</h2>{product.description && <p>{product.description}</p>}{product.features.length > 0 && <><h3 class="display">Destaques</h3><ul>{product.features.map((feature) => <li>{feature}</li>)}</ul></>}{product.specifications.length > 0 && <><h3 class="display">Especificações</h3><dl>{product.specifications.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}{spec.unit && ` ${spec.unit}`}</dd></div>)}</dl></>}</div>}</div></div></div></section>
  <RelatedProducts products={relatedProducts(product)} />
</BaseLayout>
<style>.product-detail{padding-top:2rem}.breadcrumbs{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:2rem;color:var(--muted);font-size:.9rem}.detail-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,6vw,6rem);align-items:start}.product-copy h1{font-size:clamp(3rem,6vw,6rem);line-height:.82;margin:.65rem 0}.ref{font-weight:700;color:var(--muted)}.lead{font-size:1.25rem;color:var(--muted);max-width:38ch;margin-block:1.5rem 2rem}.product-copy>.product-whatsapp{font-size:1.08rem}.copy-block{margin-top:3rem;border-top:1px solid var(--border);padding-top:1.5rem}.copy-block h2{font-size:2rem;margin-top:0}.copy-block h3{font-size:1.25rem;margin:2rem 0 .5rem}.copy-block ul{padding-left:1.2rem}.copy-block dl{margin:0;border-top:1px solid var(--border)}.copy-block dl div{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-bottom:1px solid var(--border)}.copy-block dt{font-weight:700}.copy-block dd{margin:0;color:var(--muted)}@media(max-width:800px){.detail-grid{grid-template-columns:1fr}.product-copy>.product-whatsapp{position:sticky;z-index:5;bottom:1rem;box-shadow:0 4px 16px rgb(0 0 0 / 25%)}.copy-block{margin-top:2rem}}</style>
