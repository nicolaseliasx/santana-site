---
import BaseLayout from '@/layouts/BaseLayout.astro'; import ProductCard from '@/components/catalog/ProductCard.astro'; import SearchControls from '@/components/catalog/SearchControls.astro'; import { products, catalogGroups } from '@/data/catalog';
---
<BaseLayout title="Produtos | Santana Fitness" description="Explore o catálogo de equipamentos Santana Fitness."><section class="section"><div class="container" data-catalog-root><div class="page-heading"><span class="eyebrow">Catálogo</span><h1 class="display">Produtos</h1><p class="muted">Equipamentos para montar um espaço de treino completo.</p></div><SearchControls categories={catalogGroups} /><div class="grid product-grid">{products.map((product) => <ProductCard product={product} />)}</div></div></section></BaseLayout>
<style>.page-heading{margin-bottom:2.5rem}.page-heading h1{margin:.3rem 0;font-size:clamp(3.5rem,8vw,7rem);line-height:.8}.page-heading p{font-size:1.15rem}</style>
